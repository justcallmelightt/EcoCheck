# 이 파일을 backend/.env로 복사하세요. 키/비밀번호는 .env에서만 수정합니다.
# IntelliJ main 실행 시 작업 디렉터리를 EcoCheck 또는 EcoCheck/backend로 지정합니다.
ECOCHECK_HOST=127.0.0.1
ECOCHECK_PORT=8080
ECOCHECK_DB_URL=jdbc:mysql://127.0.0.1:3306/ecocheck?characterEncoding=UTF-8&connectionTimeZone=UTC&connectTimeout=3000&socketTimeout=5000
ECOCHECK_DB_USER=ecocheck
ECOCHECK_DB_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
