# Copy to .env in backend/. Real values must not be committed.
ECOCHECK_HOST=127.0.0.1
ECOCHECK_PORT=8080
ECOCHECK_DB_URL=jdbc:mysql://127.0.0.1:3306/ecocheck?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8&connectTimeout=5000&socketTimeout=5000
ECOCHECK_DB_USER=ecocheck
ECOCHECK_DB_PASSWORD=replace-with-your-local-password
